# record.env -- default lerobot-record settings for `launch_teleop.sh <remote|local> record`.
# Loaded by launch_teleop.sh after connect.env; the shell, the CLI, and a dataset env file
# (DATASET=<name> -> record-datasets/<name>.env) all override these (the loader only sets a
# var that is still unset). Separate from connect.env, which holds connection + teleop only.
# Full rationale for every knob: .docs/RECORD.md.
# ---------------------------------------------------------------------------------

# ===== Dataset identity / naming ==================================================
# Base repo_id; on-disk folder is <cache>/<repo_id>. "local/" keeps push_to_hub off.
DATASET_REPO_ID="local/vega_exo_base"
DATASET_TASK="teleoperation"

# Suffix label: chunks become <repo_id>_<SESSION_LABEL>NN (NN auto-iterates, scanning the
# cache so separate sessions continue numbering instead of colliding at _s01).
SESSION_LABEL="s"

# NO_STAMP=true -> folder is EXACTLY the repo_id (no _timestamp), required for the _sNN
# scheme aggregate_sessions.py discovers. false -> lerobot adds its own timestamp.
NO_STAMP="true"

# RESUME=true appends to ONE existing dataset (--resume). Mutually exclusive with chunking.
RESUME="false"

# ===== Failsafe: chunking =========================================================
# true -> split NUM_EPISODES into back-to-back sub-datasets of EPISODES_PER_CHUNK each
# (<repo_id>_<SESSION_LABEL>NN), each finalized independently so a crash loses at most the
# in-progress episode. false -> one dataset for the whole session.
CHUNK_EPISODES="true"
EPISODES_PER_CHUNK="5"

# ===== Episode timing / rate ======================================================
NUM_EPISODES="10"
EPISODE_TIME_S="60"
RESET_TIME_S="15"
FPS="20"               # = omniteleop command_rate; recording faster only dupes frames

# ===== Recorded components (must not change mid-dataset) ===========================
WITH_CHASSIS="true"
WITH_BASE_BACK_CAMERA="true"
WITH_BASE_FRONT_CAMERA="true"
WITH_HEAD_DEPTH="true"  # heaviest encoder; drop to false if the loop can't hold FPS

# ===== Teleop freshness ===========================================================
# VegaExoJoycon.is_connected flips false after this long with no robot/safe_commands; 2.0s
# rides out hiccups while still catching a dead command_processor.
MAX_COMMAND_AGE_S="2.0"

# ===== Encoding / writer knobs (hold the loop near FPS) ===========================
STREAMING_ENCODING="false"
ENCODER_THREADS="2"
NUM_IMAGE_WRITER_PROCS="4"
RGB_VCODEC="h264"

# ===== Episode control ============================================================
# RECORD_MODE picks how episodes advance AND the run path:
#   fixed       -> auto-advance on the timers (foreground / headless)
#   interactive -> TTY keys n=next r=re-record q=quit (ssh -t / local window)
#   joycon      -> exo JoyCon over zenoh, headless (no focused terminal needed)
# EPISODE_BTN_* map the three actions to <side>_<button>. See .docs/JOYCON_EPISODE_CONTROL.md.
RECORD_MODE="joycon"
EPISODE_BTN_NEXT="left_right"       # -> exit_early  (advance to next episode)
EPISODE_BTN_RERECORD="left_left"    # -> rerecord    (discard + redo last episode)
EPISODE_BTN_STOP="right_left"       # -> stop        (finish and finalize the run)

# ===== HF Hub ====================================================================
PUSH_TO_HUB="false"
