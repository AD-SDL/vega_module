# jetson_record.env -- shared recording config for launch_jetson_lerobot_fixed.sh and
# launch_jetson_lerobot_interactive.sh. Both `source` this. Shell / ../.env override it
# (so NUM_EPISODES=3 ./launch_jetson_lerobot_fixed.sh works for a one-off). Read on mj
# and forwarded to the Jetson over ssh -- NOT sourced on the Jetson directly.
# Full rationale for every knob: .docs/JETSON_RECORDING.md.
# ---------------------------------------------------------------------------------

# ===== Dataset identity / naming ==================================================

# Base repo_id. The on-disk folder is ~/.cache/huggingface/lerobot/<repo_id> ON THE
# JETSON (datasets are written locally there for the frequency win, then rsync'd back
# to mj -- the launcher prints the exact pull command). "local/" keeps push_to_hub off.
DATASET_REPO_ID="local/vega_exo_base"

# Natural-language task string stored on every frame (dataset.single_task).
DATASET_TASK="teleoperation"

# A short label that disambiguates one recording session from another and becomes
# part of the chunked repo_id (see CHUNKING). Bump it per session so two sessions
# never collide on disk. Example: "pickup_s" -> chunks local/vega_exo_base_pickup_s01, _s02...
SESSION_LABEL="s"

# NO_STAMP=true  -> the on-disk folder is EXACTLY the repo_id (no _YYYYMMDD_HHMMSS),
#   which the per-session naming scheme + aggregate_sessions.py depend on. You must
#   then give a UNIQUE repo_id per run (chunking does this for you; see below).
# NO_STAMP=false -> lerobot appends its own timestamp at create time (its default);
#   safe against collisions but breaks the _sNN discovery scheme.
NO_STAMP="true"

# Append to an EXISTING dataset instead of creating a new one (lerobot-record
# --resume=true). Only valid against a repo_id that already exists on the Jetson with
# a MATCHING feature schema. Mutually exclusive with chunking (a resumed run is a
# single dataset, not a fresh _sNN series) -- the launcher errors if both are set.
RESUME="false"

# ===== Failsafe: chunking =========================================================
# When CHUNK_EPISODES=true, a session of NUM_EPISODES is split into back-to-back
# sub-datasets of EPISODES_PER_CHUNK each: local/<...>_<SESSION_LABEL><NN>. Every
# chunk is an independent create -> record -> save_episode -> finalize cycle, so a
# crash or a dropped link loses AT MOST the one in-progress episode of the current
# chunk -- all earlier chunks are already finalized and readable on disk. Each chunk
# is also directly consumable by aggregate_sessions.py (that's the _sNN it expects).
#
# CHUNK_EPISODES=false -> one dataset for the whole session (lowest overhead, but a
#   hard-kill before the final finalize() risks the whole session's v3.0 footer).
CHUNK_EPISODES="true"
EPISODES_PER_CHUNK="5"

# ===== Episode timing / rate ======================================================
NUM_EPISODES="10"      # total episodes for the whole session (across all chunks)
EPISODE_TIME_S="60"    # seconds per episode (fixed variant auto-advances on this)
RESET_TIME_S="15"      # non-recording pause between episodes (env reset + encode)
FPS="20"               # = omniteleop command_rate; recording faster only dupes frames

# ===== Recorded components (must not change mid-dataset) ===========================
# Mobile base action (base.vx/vy/wz) + chassis proprio, set on BOTH robot and teleop.
WITH_CHASSIS="true"
WITH_BASE_BACK_CAMERA="true"
WITH_BASE_FRONT_CAMERA="true"
# Head stereo depth (lossless x265, heaviest encoder). Drop to false if the loop
# can't hold FPS even with obs now local to the Jetson.
WITH_HEAD_DEPTH="true"

# ===== Teleop freshness ===========================================================
# VegaExoJoycon.is_connected flips false after this many seconds without a
# robot/safe_commands message, and get_action() then raises, ending the episode.
# 2.0s rides out transient hiccups while still catching a dead command_processor.
MAX_COMMAND_AGE_S="2.0"

# ===== Encoding / writer knobs (keep the loop near FPS) ===========================
# See launch_exo_lerobot.sh for the full rationale. Short version: streaming OFF +
# image-writer subprocesses + h264 is the combination that holds 20 Hz here.
STREAMING_ENCODING="false"
ENCODER_THREADS="2"
NUM_IMAGE_WRITER_PROCS="4"
RGB_VCODEC="h264"

# ===== HF Hub ====================================================================
# Off for local/ repo_ids (push would fail). Datasets come back to mj via rsync, not the Hub.
PUSH_TO_HUB="false"

# ===== Jetson execution ==========================================================
# conda env on the Jetson with lerobot (vega_1p), dexcontrol (chassis_and_base),
# dexbot-utils (base-cameras fork), dexcomm. See .docs/JETSON_RECORDING.md to sync.
JETSON_ENV="rollout"
