# record-datasets/example.env -- per-dataset record overrides. Copy to <name>.env (one per
# dataset you're working on) and select with:  DATASET=<name> ./launch_teleop.sh remote record
# (bare name -> record-datasets/<name>.env; a path also works). Only set what differs from
# record.env for this dataset; everything unset falls back to record.env. CLI/shell still win.
# See .docs/RECORD.md.

DATASET_REPO_ID="local/example_task"
DATASET_TASK="pick up the example object and place it in the bin"
SESSION_LABEL="s"

# Optional per-dataset overrides (uncomment as needed):
# NUM_EPISODES="20"
# EPISODE_TIME_S="45"
# EPISODES_PER_CHUNK="5"
# RECORD_MODE="joycon"
# RESUME="false"
