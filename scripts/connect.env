# connect.env -- connection settings for connect.sh (remote=MJ, local=Jetson).

# ===== Robot identity (both targets) =====
ROBOT_NAME="dm/vg4e69870ce2-1p"
ROBOT_CONFIG="vega_1p_gripper"
ROBOT_IP="127.0.0.1"

# ===== remote target (off-robot, SSH tunnel to the Zenoh router) =====
VEGA_HOST="146.137.240.51"
VEGA_USER="dexmate"
ZENOH_PORT="7447"
REMOTE_ZENOH_CONFIG="$HOME/.dexmate/comm/zenoh/dm_vg4e69870ce2-1p.dzcfg"

# ===== local target (on the robot's Jetson, loopback router, no tunnel) =====
LOCAL_ZENOH_CONFIG="$HOME/dm_vg4e69870ce2-1p.dzcfg"

# ===== teleop (launch_teleop.sh) =====
VENV_PATH="$HOME/venvs/dexmate"
JETSON_ENV="rollout"
JETSON_VEGA_DIR="~/vega_module"
EXO_DEV_PORT="/dev/ttyUSB0"
LAUNCH_SENSORS="true"
LAUNCH_TELEMETRY_VIEWER="false"
